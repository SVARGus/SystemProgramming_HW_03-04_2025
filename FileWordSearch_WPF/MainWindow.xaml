<Window x:Class="FileWordSearch_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileWordSearch_WPF"
        mc:Ignorable="d"
        Title="MainWindow" SizeToContent="Height" MinHeight="200" MaxHeight="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Укажите искомое слово" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SearchTextBox" FontSize="18" Margin="5"/>

        <CheckBox Grid.Row="1" Grid.Column="0" Content="Учитывать регистр?" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" x:Name="CaseSensitiveCheckBox"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Выберите файл" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SelectFileTextBox" FontSize="18" Margin="5" Width="400" HorizontalScrollBarVisibility="Auto"/>
            <Button x:Name="SelectFileButton" Content="Выбрать" Width="100" Click="SelectFileButton_Click"/>
        </StackPanel>

        <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Начать поиск" x:Name="StartSearchButton" Margin="15" FontSize="24" FontWeight="Bold" Click="StartSearchButton_Click"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Количество найденных слов" Margin="5" FontSize="20"/>
            <TextBlock x:Name="CountSearchTextBlock" Margin="5" FontSize="20"/>
        </StackPanel>
    </Grid>
</Window>
