<Window x:Class="CW_Thread_31_03_2025_Task7_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CW_Thread_31_03_2025_Task7_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Укажите диапазон гененрируемых чисел" Margin="5" Width="250"/>
            <TextBlock Text="Min: " Margin="5"/>
            <TextBox x:Name="StartTB" Margin="6" Width="50"/>
            <TextBlock Text="Max: " Margin="5"/>
            <TextBox x:Name="EndTB" Margin="6" Width="50"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Укажите размер массива чисел" Margin="5" Width="200"/>
            <TextBox x:Name="CountTB" Margin="6" Width="50"/>
        </StackPanel>
        <Button Grid.Row="2" x:Name="StartButton" Content="Сгенерировать массив и вычислить min, max, avg" Margin="5" Click="StartButton_Click"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <TextBlock Text="Минимальное значение = " Margin="5"/>
            <TextBlock Text="{Binding Min}" Margin="5"/>
            <TextBlock Text="Максимальное значение = " Margin="5"/>
            <TextBlock Text="{Binding Max}" Margin="5"/>
            <TextBlock Text="Среднее значение = " Margin="5"/>
            <TextBlock Text="{Binding Average}" Margin="5"/>
        </StackPanel>
        <Button Grid.Row="4" Content="открыть файл с сохраненными данными" Margin="5" x:Name="OpenButton" Click="OpenButton_Click"/>
    </Grid>
</Window>
