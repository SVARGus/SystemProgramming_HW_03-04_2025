<Window x:Class="HorseRacingMultithreading.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HorseRacingMultithreading"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000">
    <StackPanel>
        <TextBlock Text="Конные скачки" FontSize="50" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
        <Grid x:Name="MyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Horse #1" FontSize="20" FontWeight="Bold" Width="100" VerticalAlignment="Center" Margin="5"/>
            <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="Horse1" Minimum="0" Maximum="100" Height="30" Margin="5" Foreground="LightGreen" Value="30" Tag="Horse #1"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Horse #2" FontSize="20" FontWeight="Bold" Width="100" VerticalAlignment="Center" Margin="5"/>
            <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="Horse2" Minimum="0" Maximum="100" Height="30" Margin="5" Foreground="LightCoral" Value="30" Tag="Horse #2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Horse #3" FontSize="20" FontWeight="Bold" Width="100" VerticalAlignment="Center" Margin="5"/>
            <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="Horse3" Minimum="0" Maximum="100" Height="30" Margin="5" Foreground="LightSalmon" Value="30" Tag="Horse #3"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Horse #4" FontSize="20" FontWeight="Bold" Width="100" VerticalAlignment="Center" Margin="5"/>
            <ProgressBar Grid.Row="3" Grid.Column="1" x:Name="Horse4" Minimum="0" Maximum="100" Height="30" Margin="5" Foreground="LightCyan" Value="30" Tag="Horse #4"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Horse #5" FontSize="20" FontWeight="Bold" Width="100" VerticalAlignment="Center" Margin="5"/>
            <ProgressBar Grid.Row="4" Grid.Column="1" x:Name="Horse5" Minimum="0" Maximum="100" Height="30" Margin="5" Foreground="LightBlue" Value="30" Tag="Horse #5"/>

        </Grid>
        <Button Content="Старт скачек" FontSize="35" FontWeight="Bold" x:Name="StartButton" Click="StartButton_Click"/>
        <TextBlock Text="Результаты скачек" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Первое место: " Margin="5" FontSize="15"/>
            <TextBlock x:Name="FirstPlase" Margin="5" FontSize="15" Text="Test"/>
            <TextBlock Text="Второе место: " Margin="5" FontSize="15"/>
            <TextBlock x:Name="SecondPlase" Margin="5" FontSize="15" Text="Test"/>
            <TextBlock Text="Третье место: " Margin="5" FontSize="15"/>
            <TextBlock x:Name="ThirdPlase" Margin="5" FontSize="15" Text="Test"/>
            <TextBlock Text="Четвертое место: " Margin="5" FontSize="15"/>
            <TextBlock x:Name="FourthPlase" Margin="5" FontSize="15" Text="Test"/>
            <TextBlock Text="Пятое место: " Margin="5" FontSize="15"/>
            <TextBlock x:Name="FifthPlase" Margin="5" FontSize="15" Text="Test"/>
        </StackPanel>
    </StackPanel>
</Window>
