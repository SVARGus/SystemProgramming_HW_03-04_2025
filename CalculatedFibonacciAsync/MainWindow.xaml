<Window x:Class="CalculatedFibonacciAsync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalculatedFibonacciAsync"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="10">
        <TextBlock Text="Введите предел для чисел Фибоначчи:" FontSize="16" Margin="0,0,0,10"/>
        <TextBox x:Name="InputLimit" Height="30" FontSize="14" Margin="0,0,0,10"/>
        <Button Content="Старт" Click="StartButton_Click" Height="35" FontSize="16"/>
        <TextBlock Text="Результат:" FontSize="16" Margin="0,10,0,5"/>
        <TextBox x:Name="ResultBox" Height="100" FontSize="14" TextWrapping="Wrap" IsReadOnly="True"/>
    </StackPanel>
</Window>
